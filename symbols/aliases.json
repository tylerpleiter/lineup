    },
    "sp4t": {
      "type": "switch",
      "params": {
        "throws": 4
      }
    },
    "spnt": {
      "type": "switch",
      "params": {
        "throws": 4
      }
    },
    "clipper": {
      "type": "limiter",
      "label": "Clipper"
    },
    "preemph": {
      "type": "filter",
      "variant": "preemph"
    },
    "deemph": {
      "type": "filter",
