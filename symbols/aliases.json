      "label": "LNA"
    },
    "pa": {
      "type": "amp",
      "label": "PA"
    },
    "driver": {
      "type": "amp",
      "label": "DRV"
    },
    "drv": {
      "type": "amp",
      "label": "DRV"
    },
    "vga": {
      "type": "amp",
      "label": "VGA",
      "variant": "adjustable"
    },
    "gain": {
      "type": "amp"
    },
    "aaf": {
      "type": "lpf",
      "label": "AAF"
    },
    "saw": {
      "type": "bpf",
      "label": "SAW"
    },
    "baw": {
      "type": "bpf",
      "label": "BAW"
    },
    "pll": {
      "type": "lo",
      "label": "PLL"
    },
    "synth": {
      "type": "lo",
      "label": "Synth"
    },
    "vco": {
