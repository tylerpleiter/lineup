    "fir": {
      "type": "custom",
      "label": "FIR",
      "domain": "digital"
    },
    "iir": {
      "type": "custom",
      "label": "IIR",
      "domain": "digital"
    },
    "fft": {
      "type": "custom",
      "label": "FFT",
      "domain": "digital"
    },
    "cordic": {
      "type": "custom",
      "label": "CORDIC",
      "domain": "digital"
    },
    "agc": {
      "type": "custom",
      "label": "AGC",
